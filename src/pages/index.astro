---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  {
    number: '01',
    title: 'Restauración ecológica',
    text: 'Acompañamos la recuperación de ecosistemas degradados desde la planeación hasta el cuidado de cada proceso vivo.',
  },
  {
    number: '02',
    title: 'Educación ambiental',
    text: 'Creamos escuelas ambientales para que niñas y niños aprendan en el bosque, con curiosidad, respeto y asombro.',
  },
  {
    number: '03',
    title: 'Monitoreo de fauna',
    text: 'Observamos y registramos la biodiversidad para comprender el territorio y tomar mejores decisiones de conservación.',
  },
];

const values = [
  ['Territorio', 'Trabajamos desde y con las particularidades de cada paisaje.'],
  ['Comunidad', 'Sumamos saberes locales, instituciones y nuevas generaciones.'],
  ['Biodiversidad', 'Protegemos las relaciones que hacen posible la vida.'],
];
---

<BaseLayout>
  <main>
    <section class="hero" id="inicio">
      <nav class="nav container" aria-label="Navegación principal">
        <a class="brand" href="#inicio" aria-label="Forestal Colombia, inicio">
          <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>Forestal<br /><em>Colombia</em></span>
        </a>
        <div class="nav-links">
          <a href="#hacemos">Lo que hacemos</a>
          <a href="#territorio">El territorio</a>
          <a href="#contacto">Contacto</a>
        </div>
        <a class="nav-cta" href="#contacto">Conversemos <span aria-hidden="true">↗</span></a>
      </nav>

      <div class="hero-content container">
        <p class="eyebrow light"><span></span> Colombia biodiversa</p>
        <h1>Donde el bosque<br />vuelve a <em>respirar.</em></h1>
        <div class="hero-bottom">
          <p>Restauramos ecosistemas, despertamos curiosidad y cuidamos la vida que habita nuestros territorios.</p>
          <a class="round-link" href="#hacemos" aria-label="Explorar nuestro trabajo"><span>Explorar</span><b aria-hidden="true">↓</b></a>
        </div>
      </div>

      <div class="hero-caption container">
        <span>Restauración · Educación · Monitoreo</span>
        <span>Colombia</span>
      </div>
    </section>

    <section class="intro section container" id="territorio">
      <div class="intro-heading">
        <p class="eyebrow"><span></span> Nuestro propósito</p>
        <h2>La conservación empieza cuando volvemos a <em>mirar</em> el lugar que habitamos.</h2>
      </div>
      <div class="intro-copy">
        <p>Somos una iniciativa comprometida con la protección y restauración de ecosistemas degradados en Colombia. Creemos que cada semilla, cada ave y cada pregunta de un niño puede abrir un camino para cuidar la vida.</p>
        <a class="text-link" href="#contacto">Conoce el territorio <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="landscape" aria-label="Bosque nuboso colombiano">
      <div class="landscape-card container">
        <p>Una alianza por paisajes<br />más vivos y resilientes.</p>
        <span>01 / 03</span>
      </div>
    </section>

    <section class="services section container" id="hacemos">
      <div class="section-top">
        <p class="eyebrow"><span></span> Lo que hacemos</p>
        <p class="section-note">Acciones que conectan la ciencia, el cuidado y las personas.</p>
      </div>
      <div class="service-list">
        {services.map((service) => (
          <article class="service">
            <span class="service-number">{service.number}</span>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
            <span class="service-arrow" aria-hidden="true">↗</span>
          </article>
        ))}
      </div>
    </section>

    <section class="education section">
      <div class="education-image" role="img" aria-label="Niña observando aves en el bosque"></div>
      <div class="education-copy">
        <p class="eyebrow light"><span></span> Escuelas ambientales</p>
        <h2>Aprender con los pies en la tierra.</h2>
        <p>Diseñamos experiencias de avistamiento y monitoreo de fauna para que niñas y niños conozcan la biodiversidad de cerca y se reconozcan como sus guardianes.</p>
        <a class="button button-light" href="#contacto">Hablemos de una escuela <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="principles section container">
      <p class="eyebrow"><span></span> Nuestra forma de hacer</p>
      <div class="principles-grid">
        {values.map(([title, text], index) => (
          <article>
            <span>0{index + 1}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="contact" id="contacto">
      <div class="container contact-inner">
        <p class="eyebrow light"><span></span> Hagamos equipo</p>
        <h2>El futuro se siembra<br />en <em>compañía.</em></h2>
        <p class="contact-copy">¿Tienes un proyecto, una escuela o un territorio que quiere volver a florecer? Escríbenos.</p>
        <a class="email" href="mailto:hola@forestalcolombia.co">hola@forestalcolombia.co <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>

  <footer>
    <div class="container footer-inner">
      <a class="brand footer-brand" href="#inicio">
        <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>Forestal<br /><em>Colombia</em></span>
      </a>
      <p>Protección, restauración y educación ambiental en Colombia.</p>
      <span>© {new Date().getFullYear()} Forestal Colombia</span>
    </div>
  </footer>
</BaseLayout>
